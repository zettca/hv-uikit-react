{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "strict": true,

    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Node",
    "paths": {
      "components/*": ["src/components/*"],
      "pages/*": ["src/pages/*"],
      "lib/*": ["src/lib/*"],
      "headerActions/*": ["src/headerActions/*"],
      "providers/*": ["src/providers/*"]
    },
    "resolveJsonModule": true,
    "types": ["node"],

    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "outDir": "dist",
    "sourceMap": true,

    "allowJs": false,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "preserveSymlinks": true,

    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "target": "ESNext",

    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "app-shell.config.ts", "src"],
  "exclude": ["node_modules"]
}
