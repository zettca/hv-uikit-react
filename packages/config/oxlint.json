{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "react", "oxc", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "es2022": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["*.d.ts", "dist", "node_modules", "playwright.config.ts"],
  "rules": {
    // Rules with issues
    "react/jsx-key": "off", // due to spread order
    "no-unused-vars": "off", // due to no `ignoreRestSiblings` & ignorePattern

    // Relax default strictness
    "jsx_a11y/no-autofocus": "off",
    "jsx_a11y/role-supports-aria-props": "off",
    "jsx_a11y/role-has-required-aria-props": "off"
  },
  "settings": {
    "react": {
      "formComponents": [],
      "linkComponents": ["HvLink"]
    },
    "jsx-a11y": {
      "polymorphicPropName": "",
      "components": {
        "HvButton": "button",
        "HvButtonBase": "button"
      }
    },
    "jsdoc": {
      "tagNamePreference": {
        "augments": "extends"
      }
    }
  }
}
